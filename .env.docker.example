# Local Docker stack env — template. `scripts/dev-stack.sh` generates the live
# `.env.docker` from this by filling the Supabase keys from `supabase status` and
# generating fresh secrets. Committed as a reference; the generated `.env.docker`
# is gitignored. These are LOCAL DEV values only — never real secrets.

# ── Supabase (local CLI stack: `supabase start`) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from: supabase status -o env (ANON_KEY)>
SUPABASE_SERVICE_ROLE_KEY=<from: supabase status -o env (SERVICE_ROLE_KEY)>

# ── Redis over REST (docker/compose.yml: redis + serverless-redis-http) ───────
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=passcontrol_local_dev_token

# ── Secrets (dev-stack.sh generates random values) ───────────────────────────
VISA_SECRET=<generated: 32+ random bytes>
VISA_TTL_SECONDS=300
CACHE_ENC_KEY=<generated: openssl rand -base64 32>
CRON_SECRET=<generated>

# ── Instance signing key (signed receipts + agent-to-agent tokens) ───────────
# The Ed25519 seed this deployment signs receipts with. Its PUBLIC half is served
# at /.well-known/jwks.json so a third party can verify a receipt offline.
# Unset is a supported state: receipts are simply off, and the proxy behaves
# exactly as it did before the feature existed.
#
# dev-stack.sh generates this once and then CARRIES IT FORWARD on every later
# run. That is not tidiness — a receipt has no expiry and is verified by matching
# `kid` against the published key set, so replacing the seed retroactively breaks
# every receipt this stack has ever signed.
INSTANCE_SIGNING_KEY=<generated: openssl rand -base64 32>
# The previous seed, kept only so artifacts signed before a rotation still
# verify. Note this INVERTS the meaning of VISA_SECRET_PREV: nothing ever signs
# with it, we only keep publishing its public half. Empty until you rotate.
INSTANCE_SIGNING_KEY_PREV=
# The `iss` stamped into every receipt, and the origin a verifier resolves
# /.well-known/jwks.json against. Must be an https origin — with a carve-out for
# loopback http so the local stack works. Never derived from the Host header.
PASSCONTROL_ISSUER=http://localhost:3000
# Local build identity. Keep SHA blank; development makes the local state
# explicit. System Health remains restricted to named, TOTP-enrolled operators.
PASSCONTROL_BUILD_SHA=
PASSCONTROL_RELEASE_CHANNEL=development
PASSCONTROL_SYSTEM_OPERATOR_EMAILS=

# ── Dashboard signup gate ────────────────────────────────────────────────────
INVITE_CODE=local-dev

# ── Seed user (scripts/seed.mjs) ─────────────────────────────────────────────
# No default password. scripts/seed.mjs prompts for one, or generates a random
# one when it cannot prompt. A committed value here would be the same password on
# every install on earth, guarding a Vault that holds real provider keys.
DEV_USER_EMAIL=dev@passcontrol.local
DEV_USER_PASSWORD=

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set to 1 to enable the keyless `demo` provider + seed a demo passport, so a
# stranger can run `passcontrol try` (governed call + kill switch, no real key).
# OFF by default; production must never enable it. Bring the stack up with:
#   PASSCONTROL_DEMO=1 npm run dev:stack  &&  PASSCONTROL_DEMO=1 npm run dev:docker
PASSCONTROL_DEMO=0
