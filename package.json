{
  "name": "passcontrol",
  "version": "0.6.1",
  "description": "Identity, scope and budget controls for AI agents while provider keys stay server-side.",
  "license": "BUSL-1.1",
  "homepage": "https://passcontrol.vertias.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertias3u/PassControl.git"
  },
  "bugs": {
    "url": "https://github.com/Vertias3u/PassControl/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "gateway",
    "credentials",
    "identity",
    "api-key",
    "vault",
    "proxy",
    "passport"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "cli",
    "!cli/**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "passcontrol": "bin/passcontrol.mjs"
  },
  "scripts": {
    "cli": "node bin/passcontrol.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "bash scripts/migrate.sh",
    "dev:stack": "bash scripts/dev-stack.sh",
    "dev:docker": "bash -c 'set -a; . ./.env.docker; set +a; next dev'",
    "seed": "node scripts/seed.mjs",
    "sidecar": "node examples/visa-sidecar.mjs",
    "test:rls": "psql -v ON_ERROR_STOP=1 -f db/tests/rls_invariants.sql \"$DATABASE_URL\"",
    "test:beta-launch-db": "psql -v ON_ERROR_STOP=1 -f db/tests/beta_launch_invariants.sql \"$DATABASE_URL\"",
    "build:cli": "node scripts/build-cli-package.mjs",
    "check:release": "node scripts/check-release-integrity.mjs",
    "check:legal": "node scripts/check-legal-readiness.mjs",
    "check:paid-legal": "node scripts/check-legal-readiness.mjs --paid-commercial-launch",
    "check:cloud-beta": "npm run check:legal && node scripts/check-cloud-beta-readiness.mjs",
    "canary:cloud-beta": "node scripts/cloud-beta-canary.mjs",
    "check:npm-pack": "npm run check:release && npm run build:cli && node scripts/check-npm-package.mjs",
    "release:cli": "npm run check:npm-pack && npm publish ./dist-cli",
    "prepublishOnly": "node -e \"console.error('Publish the CLI package, not the app manifest: npm run release:cli');process.exit(1)\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/redis": "^1.34.0",
    "@vercel/functions": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "jose": "^5.9.3",
    "lucide-react": "^1.20.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "openai": "^6.49.0",
    "postcss": "^8.5.24",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "@hono/node-server": "^2.0.5",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17"
  }
}
