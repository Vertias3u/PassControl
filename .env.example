# ── Supabase ────────────────────────────────────────────────────────────────
# Public (browser) values:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# Service role — server/edge only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=ey...

# ── Visa (Scoped Access JWT) signing ─────────────────────────────────────────
# 32+ byte random secrets. VISA_SECRET_PREV enables zero-downtime rotation.
VISA_SECRET=replace-with-32+byte-random-string
VISA_SECRET_PREV=
VISA_TTL_SECONDS=300

# ── Instance signing key (Ed25519) — receipts + agent-to-agent tokens ────────
# base64url of a 32-byte Ed25519 seed. Generate: passcontrol keygen instance
# The PUBLIC half is published at /.well-known/jwks.json so third parties can
# verify what this deployment signs, offline, without an account here.
# Leave blank to run without receipts or agent tokens — nothing else changes.
INSTANCE_SIGNING_KEY=
# Previous seed. NOTE this is the OPPOSITE of VISA_SECRET_PREV: we never sign
# with it, we only keep its PUBLIC key in the JWKS so artifacts signed before
# the rotation still verify. Receipts carry no expiry, so once anything has been
# signed with a key, its entry here is effectively permanent.
# Rotating: publish the new key, wait one JWKS_MAX_AGE_SECONDS window, THEN
# start signing with it — verifiers may hold a cached key set until then.
INSTANCE_SIGNING_KEY_PREV=
# Absolute https origin, no path. This is the `iss` claim and the base another
# deployment uses to find this one's JWKS. Never derived from the Host header:
# an issuer an attacker can choose is an issuer they can point at their own key.
# http:// is accepted ONLY for loopback (http://localhost:3000) so the local
# stack can issue and verify receipts; any routable http origin is rejected.
PASSCONTROL_ISSUER=https://passcontrol.example.com
# Human-readable label on the authentication screen (not a security boundary).
PASSCONTROL_INSTANCE_LABEL=PassControl Cloud
JWKS_MAX_AGE_SECONDS=300

# ── Provider-key cache encryption (Tension 1) ────────────────────────────────
# base64-encoded 32-byte (256-bit) AES key. Generate: openssl rand -base64 32
CACHE_ENC_KEY=

# ── Upstash Redis (REST) ─────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# (Kill switch is Redis-backed — no extra Vercel services / API tokens needed.)

# ── Proxy per-agent request-rate limit (call-volume guard; budget is separate) ─
# Max proxied calls per agent per window. Generous default; tune for your fleet.
PROXY_RATE_LIMIT=600
PROXY_RATE_WINDOW_S=60
DIRECT_KEY_IP_LIMIT=60
DIRECT_KEY_IP_WINDOW_S=60
# Trust cf-connecting-ip only when Cloudflare itself is the first public edge.
# The committed Workers config opts in; leave false on Vercel/other hosts.
PASSCONTROL_TRUST_CF_CONNECTING_IP=false
# Cloud invite-beta infrastructure caps. Leave unset/0 for self-hosting.
CLOUD_BETA_WORKSPACE_CALL_LIMIT=0
CLOUD_BETA_GLOBAL_CALL_LIMIT=0

# ── Control-plane API (optional; sensible defaults if unset) ─────────────────
# Pre-auth per-IP flood guard on /api/control/v1 (requests per minute).
CONTROL_IP_LIMIT=1000

# ── Kill switch (optional) ───────────────────────────────────────────────────
# If a kill-switch Redis read fails, the default is to fail OPEN (don't block) —
# the same Redis backs budgets/suspend, so an outage already fails requests. Set
# this to "true" to fail CLOSED instead (a read failure blocks all traffic). Off
# by default. Strict operators who want the emergency stop to never pass through
# on error should enable it.
KILL_SWITCH_FAIL_CLOSED=false

# Same choice for per-agent policy rules. If the `agents.policy` row cannot be
# READ (a database blip), the default is to fail OPEN, because blocking would
# punish every agent — including the majority that configured no policy at all.
# Set to "true" to block instead. This covers the *unreadable* case only: a
# policy that IS readable but malformed always fails CLOSED, since that is an
# owner configuration error and it is shown on the agent's dashboard page.
POLICY_FAIL_CLOSED=false

# ── Cron auth ────────────────────────────────────────────────────────────────
CRON_SECRET=replace-with-random-string
# Reconcile settle-lag: only fold agent_logs rows older than this (seconds) so a
# row can't be skipped between its insert and the reconcile snapshot. Optional.
RECONCILE_LAG_SECONDS=60

# ── Security alerting (optional) ─────────────────────────────────────────────
# Incoming-webhook URL for real-time alerts on high-signal security events
# (account lockout, rate-limit trip, master kill switch, agent suspend). Works
# with a free Slack OR Discord incoming webhook. Leave blank to disable (events
# are still logged). Vercel Log Drains are the paid alternative.
SECURITY_ALERT_WEBHOOK=

# ── Error tracking / observability (optional) ────────────────────────────────
# Optional for self-hosting; REQUIRED by `npm run check:cloud-beta` before external
# invite-beta users so a lost final agent_logs insert produces an operator alert.
# The app strips request/response bodies, auth headers,
# cookies, visas, passport keys, provider keys, API keys, and service secrets
# before sending anything to Sentry.
SENTRY_DSN=

# ── Public legal identity ─────────────────────────────────────────────────────
# Optional during the free invite-only beta. Required by `npm run
# check:paid-legal` before a paid commercial launch, after qualified Bulgarian
# advice. Never publish a private home address merely to satisfy a script.
PASSCONTROL_PUBLIC_SERVICE_ADDRESS=
# Date on which the free-beta legal notices take effect (YYYY-MM-DD). Required
# by `npm run check:legal`, the Cloud beta gate, and the Vercel build.
PASSCONTROL_LEGAL_EFFECTIVE_DATE=

# ── Production authentication ────────────────────────────────────────────────
# open = public email signup; invite = shared-code gate; closed = existing users only.
# Missing/invalid values fail safely to invite. Email confirmation, recovery,
# and custom SMTP are configured in Supabase Auth; see docs/deployment/cloudflare.md.
PASSCONTROL_SIGNUP_MODE=invite
# shared preserves the original deployment-wide invite code. database enables
# migration 0025's personal, email-bound, one-time invitation links. Apply 0025
# and deploy its operator surface before changing this value.
PASSCONTROL_INVITE_SOURCE=shared
# Database invitations also require migration 0025's Before User Created Auth
# hook to be enabled in Supabase. The readiness check requires an explicit
# acknowledgement after a direct-signup rejection test; this is not an env flag.
# Used only when PASSCONTROL_INVITE_SOURCE=shared. Share it only with people you trust.
INVITE_CODE=replace-with-a-shared-invite-code
# Comma-separated exact emails allowed into /dashboard/beta. Each account must
# also have verified TOTP and an aal2 session; this allowlist is not sufficient alone.
PASSCONTROL_BETA_OPERATOR_EMAILS=
# Server-only Resend API credential for owner-triggered beta invitations and
# follow-ups. Messages are text-only and contain no tracking pixel.
RESEND_API_KEY=
PASSCONTROL_BETA_FROM_EMAIL=PassControl <hello@passcontrol.vertias.eu>
